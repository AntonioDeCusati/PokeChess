# =============================================================================
# PokeChess API — environment template
# Copy this file to `.env` and fill real values. Never commit `.env`.
# =============================================================================

# ---- Server ----------------------------------------------------------------
# Port Express binds to.
PORT=4000

# 'development' | 'test' | 'production'. When 'production' the dev-only
# /dev/* routes are NOT mounted (no temporary helpers exposed).
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS.
# Typical values: player dev server, production domain, etc.
#   dev:  http://localhost:5173
#   prod: https://play.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# Trust X-Forwarded-* headers from a reverse proxy.
#   "0" / "false"      → direct binding, no proxy (default dev)
#   "true" / "1"       → trust ONE upstream hop (typical: one nginx)
#   "2", "3", …        → trust N hops
#   "10.0.0.0/8"       → trust a specific IP/CIDR (comma-separated)
TRUST_PROXY=0

# ---- Database --------------------------------------------------------------
# Full Postgres connection string consumed by Prisma.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?<params>
#
# Native self-hosted Postgres examples:
#   - API and DB on the same host (loopback):
#       postgresql://pokechess:STRONG_PW@127.0.0.1:5432/pokechess?schema=public
#   - API on one host, DB on another (intranet):
#       postgresql://pokechess:STRONG_PW@db.internal:5432/pokechess?schema=public&sslmode=prefer
#   - Force TLS (recommended outside localhost):
#       postgresql://pokechess:STRONG_PW@db.internal:5432/pokechess?schema=public&sslmode=require
#
# Special characters in the password MUST be percent-encoded.
DATABASE_URL="postgresql://pokechess:replace-me@127.0.0.1:5432/pokechess?schema=public"

# ---- Auth ------------------------------------------------------------------
# REQUIRED. At least 16 chars (validated at boot). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# or on Linux:
#   openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string

# Expiry understood by `jsonwebtoken` (e.g. "1h", "7d", "30d").
JWT_EXPIRES_IN=7d
