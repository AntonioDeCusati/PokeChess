// PokeChess API — data model.
//
// Scope:
//   - User:              account + currencies + level/exp
//   - Creature:          catalog of monsters
//   - CreatureAnimation: per-animation frame data (idle/walk/attack/hurt)
//   - UserCreature:      inventory row per (user, creature) with level/currentExp
//   - TeamSlot:          6 rows per user (Prima Linea)
//   - Trainer:           selectable trainer avatars
//   - Support:           selectable support units
//   - Background:        selectable battle backgrounds
//   - Config:            support / trainer / background currently selected

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CreatureType {
  normal
  fire
  water
  grass
  electric
  ice
  fighting
  poison
  ground
  flying
  psychic
  bug
  rock
  ghost
  dragon
  dark
  steel
  fairy
}

enum CreatureRarity {
  common
  rare
  epic
  legendary
}

/// The four animation clips loaded at runtime for every creature.
enum AnimationType {
  idle
  walk
  attack
  hurt
}

enum ChestTier {
  wood
  iron
  gold
  diamond
}

enum TrainerRole {
  professor
  gym_leader
  elite_four
  champion
  kahuna
  captain
  rival
  leader
  elite
}

enum TeamTier {
  base
  intermediate
  final
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// End-user account. `passwordHash` is bcrypt; never returned by the API.
model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String

  // Profile / progression shown in the header and Home stats.
  level     Int @default(1)
  exp       Int @default(0)
  expToNext Int @default(1200)

  // Wallet.
  gold Int @default(0)
  gems Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatures  UserCreature[]
  teamSlots  TeamSlot[]
  config     Config?
  chests     UserChest[]
  chestLog   ChestOpenLog[]
  savedGames SavedGame[]

  @@index([email])
  @@index([username])
}

/// Catalog entry for a creature. Seeded at bootstrap and kept stable.
/// `slug` is the client-facing stable id (e.g. "flarepup").
/// `pokedexNumber` maps to the PMD sprite folder (e.g. 1 → sprite/0001/).
/// `pokedexPath`   is the relative path under apps/assets/sprite/
///                 (e.g. "0001" or "0003/0000/0001" for alternate forms).
model Creature {
  id            String @id @default(cuid())
  slug          String @unique
  pokedexNumber Int    @unique
  /// Relative path under apps/assets/sprite/ (4-digit or nested, e.g. "0006/0005").
  pokedexPath   String @unique

  name  String
  type1 CreatureType
  type2 CreatureType?

  rarity CreatureRarity

  /// Base exp required to level up (game logic may apply per-level scaling).
  expMax Int @default(100)

  canEvolve  Boolean @default(false)
  /// ID of the Creature this one evolves into (null if canEvolve = false).
  evolveToId String?

  /// Energy reward for type1 when this creature is captured.
  rewardType1 Int @default(1)
  /// Energy reward for type2 when this creature is captured (ignored if type2 is null).
  rewardType2 Int @default(1)

  createdAt DateTime @default(now())

  animations      CreatureAnimation[]
  userCreatures   UserCreature[]
  teamSlots       TeamSlot[]
  chestLogs       ChestOpenLog[]
  npcTrainerSlots NpcTrainerSlot[]

  evolveTo    Creature?  @relation("Evolution", fields: [evolveToId], references: [id])
  evolvedFrom Creature[] @relation("Evolution")

  @@index([type1])
  @@index([rarity])
}

/// Per-animation spritesheet metadata for a creature.
/// Derived from the AnimData.xml files in apps/assets/sprite/{pokedexPath}/.
/// Stored in DB to avoid XML parsing at runtime.
model CreatureAnimation {
  id         String        @id @default(cuid())
  creatureId String
  type       AnimationType

  frameWidth  Int
  frameHeight Int
  /// Total number of frames (derived from the <Durations> list length).
  frameCount  Int
  /// Per-frame durations in game ticks (60 fps), stored as a JSON int array.
  durations   Json

  /// Frame index where the rush/charge starts (attack animation only).
  rushFrame   Int?
  /// Frame index of impact (attack animation only).
  hitFrame    Int?
  /// Frame index where the creature starts returning (attack animation only).
  returnFrame Int?

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, type])
  @@index([creatureId])
}

/// A user's owned instance of a creature.
/// Level and currentExp live HERE, not on `Creature`.
model UserCreature {
  id         String  @id @default(cuid())
  userId     String
  creatureId String
  level      Int     @default(1)
  currentExp Int     @default(0)
  owned      Boolean @default(true)

  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creature Creature @relation(fields: [creatureId], references: [id])

  @@unique([userId, creatureId])
  @@index([userId])
}

/// One of the six "Prima Linea" slots for a user.
/// `moveId` is a string referencing the client catalog of MovePatterns
/// ("horizontal", "vertical", "diagonal", "l-shape", "jump", "projection").
model TeamSlot {
  id         String @id @default(cuid())
  userId     String
  slotIndex  Int
  creatureId String
  moveId     String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creature Creature @relation(fields: [creatureId], references: [id])

  @@unique([userId, slotIndex])
  @@index([userId])
}

/// Selectable trainer avatar. Managed via admin.
model Trainer {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

/// Selectable support unit. Managed via admin.
model Support {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  imageUrl    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

/// Selectable battle background. Managed via admin.
model Background {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

/// NPC trainer for singleplayer gameplay. Seeded from allenatori.json.
model NpcTrainer {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  role     TrainerRole
  region   String
  /// Type specialty label (e.g. "Roccia", "Acqua", "Misto").
  typeSpecialty String?

  /// Relative path under assets/trainer/ for the battle sprite (e.g. "oak/sprite.png").
  spritePath   String?
  /// Relative path under assets/trainer/ for the portrait (e.g. "oak/portrait.png").
  portraitPath String?

  createdAt DateTime @default(now())

  slots NpcTrainerSlot[]

  @@index([region])
  @@index([role])
}

/// One creature in an NPC trainer's team (6 per tier, 3 tiers per trainer = 18 max).
model NpcTrainerSlot {
  id         String   @id @default(cuid())
  trainerId  String
  tier       TeamTier
  slotIndex  Int
  creatureId String

  trainer  NpcTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  creature Creature   @relation(fields: [creatureId], references: [id])

  @@unique([trainerId, tier, slotIndex])
  @@index([trainerId])
}

/// A saved/exported game state for resume or sharing.
model SavedGame {
  id     String  @id @default(cuid())
  userId String
  name   String?
  /// Full BattleState JSON — positions, HP, turn, energies, etc.
  state  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-user "Configurazione" selection (the 3 cards on the Board screen).
model Config {
  userId       String   @id
  supportId    String?
  trainerId    String?
  backgroundId String?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Inventory of chests per user. One row per (user, tier).
model UserChest {
  id       String    @id @default(cuid())
  userId   String
  tier     ChestTier
  quantity Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier])
  @@index([userId])
}

/// Log of every chest opening — used for pity counter and audit.
model ChestOpenLog {
  id         String       @id @default(cuid())
  userId     String
  tier       ChestTier
  creatureId String
  rarity     CreatureRarity
  wasPity    Boolean      @default(false)
  openedAt   DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creature Creature @relation(fields: [creatureId], references: [id])

  @@index([userId, tier])
  @@index([userId])
}
